# ThreatDesk .env (copy to .env). ANTHROPIC_* is NOT read from here:
# set the API key in Settings -> AI, or in the real OS environment.
THREATDESK_PORT=8444
# Org technology: a CSV (see config/tech-stack.template.csv), an inventory JSON, or a comma list.
THREATDESK_TECH_STACK_CSV=config/tech-stack.csv
# Demo: a synthetic Fortune-50 inventory (fictional "Meridian Global").
# THREATDESK_TECH_STACK_CSV=samples/meridian-global.csv
THREATDESK_INVENTORY=
THREATDESK_TECH_STACK=
# Optional: raises NVD rate limits.
NVD_API_KEY=
